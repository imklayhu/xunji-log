# 训记 Dashboard 自托管配置
# 复制后填写：cp .env.example .env

# —— 必填 ——
# 训记 Open API Key（在训记 App 中申请，形如 xjllm_...）
# 不要把真实 Key 提交到 Git
XUNJI_API_KEY=

# —— 服务 ——
DASHBOARD_PORT=8080
TZ=Asia/Shanghai
COMPOSE_PROJECT_NAME=xunji-dashboard

# —— 定时增量同步 ——
SYNC_ENABLED=true
# cron: 分 时 日 月 周（默认每天 06:30）
SYNC_CRON=30 6 * * *
# 每次强制重抓最近 N 天（含今天）
SYNC_REFRESH_DAYS=3
